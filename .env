# Logs
LOG_DIR_MYSQL=./infra/logs/mysql

# Configuration MySQL
MYSQL_DUMP_DIR=./infra/mysql/dump
MYSQL_DATA_DIR=./infra/mysql/data
MYSQL_CONF_FILE=./infra/mysql/my.cnf
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=springboot
MYSQL_USER=root
MYSQL_PORT=3307

# URLs de connexion
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/springboot
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# PhpMyAdmin
PMA_PORT=5100

# API Spring Boot
API_PORT=9090

# Web
WEB_PORT=9092

# DOCKERHUB nom images
API_IMAGE_NAME=leos51/api:latest
WEB_IMAGE_NAME=leos51/web:latest

